/dts-v1/;
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/power/mt7623a-power.h>
#include "mt7623a.dtsi"
#include "mt6323.dtsi"

/ {
	model = "Ubiquiti UniFi Cloud Key Gen1";
	compatible = "ubnt,unifi-cloud-key-gen1", "mediatek,mt7623";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x11004000 console=ttyS0,115200";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart2;
		ethernet0 = &gmac0;
		mmc0 = &mmc0;
		mmc1 = &mmc1;
		led-boot = &status_white;
		led-failsafe = &status_blue;
		led-running = &status_white;
		led-upgrade = &status_blue;
	};

	cpus {
		cpu@0 {
			proc-supply = <&mt6323_vproc_reg>;
		};

		cpu@1 {
			proc-supply = <&mt6323_vproc_reg>;
		};

		cpu@2 {
			proc-supply = <&mt6323_vproc_reg>;
		};

		cpu@3 {
			proc-supply = <&mt6323_vproc_reg>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0 0x80000000 0 0x80000000>;
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_pins_a>;
		status = "disabled";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 256 GPIO_ACTIVE_LOW>;
		};
	};
};

&btif {
	status = "okay";
};

&crypto {
	status = "okay";
};

&gmac0 {
	nvmem-cells = <&macaddr_eeprom_0 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "disabled";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	status = "okay";
	bus-width = <8>;
	max-frequency = <50000000>;
	cap-mmc-highspeed;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	non-removable;
};

&mmc1 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	status = "okay";
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	cd-gpios = <&pio 261 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_3p3v>;
};

&mt6323keys {
	status = "disabled";
	mediatek,long-press-mode = <0>;
};

&nor_flash {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				reg = <0x0 0x10000>;
				label = "EEPROM";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_eeprom_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@10000 {
				reg = <0x10000 0xf0000>;
				label = "EXT";
				read-only;
			};
		};
	};
};

&pcie {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_default>;
	power-domains = <&scpsys MT7623A_POWER_DOMAIN_HIF>;
	status = "okay";

	pcie@0,0 {
		status = "okay";
	};

	pcie@1,0 {
		status = "okay";
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie1_phy {
	status = "okay";
};

&pwrap {
	mt6323 {
		led {
			compatible = "mediatek,mt6323-led";
			#address-cells = <1>;
			#size-cells = <0>;

			status_white: led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_WHITE>;
				function = LED_FUNCTION_STATUS;
			};

			status_blue: led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_BLUE>;
				function = LED_FUNCTION_STATUS;
			};
		};
	};
};

&switch0 {
	ports {
		port@4 {
			status = "okay";
			label = "lan";
		};

		port@5 {
			status = "disabled";
		};
	};
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins_b>;
	status = "okay";
};

&usb0 {
	status = "okay";
	vusb33-supply = <&reg_3p3v>;
	vbus-supply = <&reg_3p3v>;
};

&u2phy1 {
	status = "okay";
};
